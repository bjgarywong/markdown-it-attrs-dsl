{
  "name": "markdown-it-attrs-dsl",
  "version": "0.1.0",
  "description": "Markdown-it plugin that extends markdown-it-attrs with a shorthand style DSL.",
  "license": "MIT",
  "author": "bjgarywong",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "markdown-it",
    "markdown-it-plugin",
    "attrs",
    "dsl",
    "style"
  ],
  "peerDependencies": {
    "markdown-it": "^14.1.1",
    "markdown-it-attrs": "^4.3.1"
  },
  "devDependencies": {
    "@types/markdown-it-attrs": "^4.1.3",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "tsx --test test/*.test.ts"
  }
}
